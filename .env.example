# Firecrawl API Configuration
# Optional: The repository functions with Firecrawl's keyless free tier by default.
# For higher rate limits, authenticated crawling, and Alexandria providers:
# 1. Sign up or log in at https://www.firecrawl.dev
# 2. Add your API key below or run `firecrawl login --browser` in terminal
FIRECRAWL_API_KEY=

# Google Sheet Applied Tracker
# Share your Google Sheet as "Anyone with link can view" and paste the link below:
# Format: https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit?usp=sharing
APPLIED_JOBS_SHEET_URL=
